{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mmt/jwf-laravel",
    "type": "library",
    "description": "Laravel persistence and integration adapter for mmt/jwf-core.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/encryption": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "mmt/jwf-core": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "Mmt\\JwfLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmt\\JwfLaravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmt\\JwfLaravel\\JwfLaravelServiceProvider"
            ],
            "aliases": {
                "Jwf": "Mmt\\JwfLaravel\\Facades\\Jwf"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/MMTech-Solutions/jwf-core.git"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
